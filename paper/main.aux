\newlabel{tab:gt}{{5}{16}{Fixer performance given perfect detection (56/56 recall, 0 FPs)}{table.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6}Cost-Efficiency Analysis}{16}{subsection.5.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Combined detection + fix cost (USD) for all 56 cases across all 49 pipeline combinations. The GPT-5.5 self-pipeline (\$7.10) is the most expensive cell. Haiku detect + GPT-4.1-mini fix (\$0.11) offers the best value among paid pipelines.}}{17}{figure.caption.9}\protected@file@percent }
\newlabel{fig:pareto}{{4}{17}{Combined detection + fix cost (USD) for all 56 cases across all 49 pipeline combinations. The GPT-5.5 self-pipeline (\$7.10) is the most expensive cell. Haiku detect + GPT-4.1-mini fix (\$0.11) offers the best value among paid pipelines}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces F1\,points per dollar across all 49 pipeline combinations. Higher is better. The $\star $ marks the Haiku detect + GPT-4.1-mini fix cell (620 F1\,pts/\$), the best value of any paid configuration. Ollama-fixer cells are free but produce unreliable outputs.}}{17}{figure.caption.10}\protected@file@percent }
\newlabel{fig:fixes-per-dollar}{{5}{17}{F1\,points per dollar across all 49 pipeline combinations. Higher is better. The $\star $ marks the Haiku detect + GPT-4.1-mini fix cell (620 F1\,pts/\$), the best value of any paid configuration. Ollama-fixer cells are free but produce unreliable outputs}{figure.caption.10}{}}
