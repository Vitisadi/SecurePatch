\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Full 7$\times $7 Pipeline Heatmap}{12}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces F1 scores across all 49 detector-fixer combinations. Rows are detectors; columns are fixers. Red boxes highlight the two peak cells (GPT-5.5 $\rightarrow $ Opus and GPT-5.5 $\rightarrow $ GPT-5.5, both 75\,\%). The row pattern dominates: detector choice determines the ceiling more than fixer choice.}}{13}{figure.caption.5}\protected@file@percent }
\newlabel{fig:heatmap}{{2}{13}{F1 scores across all 49 detector-fixer combinations. Rows are detectors; columns are fixers. Red boxes highlight the two peak cells (GPT-5.5 $\rightarrow $ Opus and GPT-5.5 $\rightarrow $ GPT-5.5, both 75\,\%). The row pattern dominates: detector choice determines the ceiling more than fixer choice}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Per-CWE Detection Performance}{13}{subsection.5.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Per-CWE detection recall for selected categories. ReDoS n=4 includes two CWE-400 cases whose oracle tests verify ReDoS patterns (relabeled from \texttt  {resource-exhaustion} after ground-truth correction). SQL injection n=5 includes two CWE-943 cases whose oracle tests verify SQL injection (relabeled from \texttt  {nosql-injection}). See Table\nobreakspace  {}\ref {tab:cwes} for the original CWE distribution.}}{14}{table.caption.6}\protected@file@percent }
\newlabel{tab:percwe}{{4}{14}{Per-CWE detection recall for selected categories. ReDoS n=4 includes two CWE-400 cases whose oracle tests verify ReDoS patterns (relabeled from \texttt {resource-exhaustion} after ground-truth correction). SQL injection n=5 includes two CWE-943 cases whose oracle tests verify SQL injection (relabeled from \texttt {nosql-injection}). See Table~\ref {tab:cwes} for the original CWE distribution}{table.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Detector Quality as the Dominant Variable}{14}{subsection.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Precision vs.\ recall for all detectors. Bubble size encodes false positive count. GPT-5.5 achieves the best F1 (92\,\%) through the highest precision (91\,\%). Sonnet achieves perfect recall (100\,\%) but its 15 false positives lower precision to 79\,\%. Semgrep and Regex fall far to the left, confirming that pattern-based tools miss the majority of cases.}}{15}{figure.caption.7}\protected@file@percent }
\newlabel{fig:fp-scatter}{{3}{15}{Precision vs.\ recall for all detectors. Bubble size encodes false positive count. GPT-5.5 achieves the best F1 (92\,\%) through the highest precision (91\,\%). Sonnet achieves perfect recall (100\,\%) but its 15 false positives lower precision to 79\,\%. Semgrep and Regex fall far to the left, confirming that pattern-based tools miss the majority of cases}{figure.caption.7}{}}
